# Path to the OpenCode SQLite database (read-only source of truth)
OPENCODE_DB_PATH=${HOME}/.local/share/opencode/opencode.db
# Host port for the API when run on the host (3000 is taken by Langfuse on this machine)
PORT=3001
# Postgres connection for host-side dev (host port 5433 maps to container 5432)
DATABASE_URL=postgres://ia:ia@localhost:5433/ia_dashboard
POSTGRES_USER=ia
POSTGRES_PASSWORD=ia
POSTGRES_DB=ia_dashboard