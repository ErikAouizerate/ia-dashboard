# Path to the OpenCode SQLite database (read-only source of truth)
OPENCODE_DB_PATH=${HOME}/.local/share/opencode/opencode.db
# API port when running the API directly on the host (Docker uses the internal port 3000)
PORT=3001
# Postgres connection for host-side dev (Docker services use db:5432 internally)
DATABASE_URL=postgres://ia:ia@localhost:5432/ia_dashboard
POSTGRES_USER=ia
POSTGRES_PASSWORD=ia
POSTGRES_DB=ia_dashboard
# OpenCode Zen LLM (session analysis) — model + key discovery
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://opencode.ai/zen/v1
# Path to OpenCode auth.json containing the API key (opencode / opencode-go entry)
OPENCODE_AUTH_PATH=${HOME}/.local/share/opencode/auth.json
# Optional override (takes precedence over auth.json)
# OPENCODE_API_KEY=
# Disable the background analysis worker entirely
# ANALYSIS_DISABLED=true
