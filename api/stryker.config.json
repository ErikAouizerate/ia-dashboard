{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "plugins": [
    "@stryker-mutator/jest-runner",
    "@stryker-mutator/typescript-checker"
  ],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": true
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/*.controller.ts",
    "!src/**/*.types.ts",
    "!src/db/**",
    "!src/config/**"
  ],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/api.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/api.json"
  },
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 60
  }
}
